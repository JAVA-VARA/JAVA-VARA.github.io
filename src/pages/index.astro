---
import Base from '../layouts/Base.astro';
import { allPosts, byYear, ymd, THEMES } from '../lib/posts';

const posts = await allPosts();
const years = byYear(posts);
const mainCount = posts.filter((p) => p.data.category !== 'coding-test').length;
---
<Base title="윤석주">
  <section class="intro">
    <h1>반복을 줄이는 개발자의 기록</h1>
    <p>막힌 곳은 어떻게 풀었고, 무엇을 왜 바꿨는지 적는다. 글 {mainCount}편.</p>
  </section>

  <div class="filters" role="group" aria-label="글 고르기">
    <button type="button" data-filter="all" aria-pressed="true">전체</button>
    {Object.entries(THEMES).map(([k, label]) => (
      <button type="button" data-filter={k} aria-pressed="false">{label}</button>
    ))}
    <button type="button" data-filter="coding-test" aria-pressed="false">코딩테스트</button>
  </div>

  <p class="year-tools"><button type="button" id="toggle-years">모두 펼치기</button></p>

  {years.map(([year, list], i) => (
    <details class="year" data-year open={i < 3} hidden={list.every((p) => p.data.category === 'coding-test')}>
      <summary><h2>{year}</h2> <span class="count"></span></summary>
      <ul class="posts">
        {list.map((p) => (
          <li data-theme={p.data.theme ?? ''} data-category={p.data.category ?? ''} hidden={p.data.category === 'coding-test'}>
            <span style="min-width:0">
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              {p.data.theme && <span class="theme" data-theme={p.data.theme}>{THEMES[p.data.theme]}</span>}
              {p.data.description && <span class="sub">{p.data.description}</span>}
            </span>
            <time datetime={ymd(p.data.date)}>{ymd(p.data.date).slice(5)}</time>
          </li>
        ))}
      </ul>
    </details>
  ))}

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        for (const li of document.querySelectorAll<HTMLLIElement>('.posts li')) {
          const coding = li.dataset.category === 'coding-test';
          li.hidden = f === 'coding-test' ? !coding : coding || !(f === 'all' || li.dataset.theme === f);
        }
        countYears();
      });
    }

    // 연도마다 보이는 글 수를 적고, 글이 없는 연도는 숨긴다
    const years = document.querySelectorAll<HTMLDetailsElement>('[data-year]');
    function countYears() {
      for (const y of years) {
        const n = y.querySelectorAll('li:not([hidden])').length;
        y.hidden = n === 0;
        y.querySelector('.count')!.textContent = `${n}편`;
      }
      syncToggle();
    }

    const toggle = document.getElementById('toggle-years')!;
    function syncToggle() {
      const allOpen = [...years].every((y) => y.hidden || y.open);
      toggle.textContent = allOpen ? '모두 접기' : '모두 펼치기';
    }
    toggle.addEventListener('click', () => {
      const open = toggle.textContent === '모두 펼치기';
      years.forEach((y) => (y.open = open));
      syncToggle();
    });
    years.forEach((y) => y.addEventListener('toggle', syncToggle));
    countYears();
  </script>
</Base>
