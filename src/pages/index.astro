---
import Base from '../layouts/Base.astro';
import { allPosts, byYear, ymd, THEMES } from '../lib/posts';

const posts = await allPosts();
const years = byYear(posts);
const journalCount = posts.filter((p) => p.data.source === 'journal').length;
const mainCount = posts.filter((p) => p.data.category !== 'coding-test').length;
---
<Base title="윤석주">
  <section class="intro">
    <h1>막힌 것, 바꾼 것, 배운 것</h1>
    <p>개발하며 겪은 문제와 선택을 적는 노트. 글 {mainCount}편.</p>
  </section>

  <div class="filters" role="group" aria-label="글 고르기">
    <button type="button" data-filter="all" aria-pressed="true">전체</button>
    {journalCount > 0 && Object.entries(THEMES).map(([k, label]) => (
      <button type="button" data-filter={k} aria-pressed="false">{label}</button>
    ))}
    <button type="button" data-filter="coding-test" aria-pressed="false">코딩테스트</button>
  </div>

  {years.map(([year, list]) => (
    <section class="year" data-year hidden={list.every((p) => p.data.category === 'coding-test')}>
      <h2>{year}</h2>
      <ul class="posts">
        {list.map((p) => (
          <li data-theme={p.data.theme ?? ''} data-category={p.data.category ?? ''} hidden={p.data.category === 'coding-test'}>
            <span style="min-width:0">
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              {p.data.theme && <span class="theme" data-theme={p.data.theme}>{THEMES[p.data.theme]}</span>}
              {p.data.description && <span class="sub">{p.data.description}</span>}
            </span>
            <time datetime={ymd(p.data.date)}>{ymd(p.data.date).slice(5)}</time>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        for (const li of document.querySelectorAll<HTMLLIElement>('.posts li')) {
          const coding = li.dataset.category === 'coding-test';
          li.hidden = f === 'coding-test' ? !coding : coding || !(f === 'all' || li.dataset.theme === f);
        }
        for (const y of document.querySelectorAll<HTMLElement>('[data-year]')) {
          y.hidden = !y.querySelector('li:not([hidden])');
        }
      });
    }
  </script>
</Base>
