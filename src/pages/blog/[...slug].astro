---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allPosts, adjacentPosts, ymd, navDescription, entryLabel, THEMES, type Post, type Adjacent } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, adjacent: adjacentPosts(posts, post) } }));
}

const { post, adjacent } = Astro.props as { post: Post; adjacent: Adjacent };
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description}>
  <article>
    <header class="post-head">
      <h1>{d.title}</h1>
      <div class="meta">
        <time datetime={ymd(d.date)}>{ymd(d.date)}</time>
        {d.theme && <span class="theme" data-theme={d.theme}>{THEMES[d.theme]}</span>}
        {d.tags.length > 0 && <span>{d.tags.join(', ')}</span>}
      </div>
    </header>
    {adjacent.series && (
      <details class="series-toc">
        <summary>{adjacent.series.project?.name ?? '연재'} <span>{adjacent.series.index}/{adjacent.series.total}편, 목차</span></summary>
        <ol>
          {adjacent.series.posts.map((p) => (
            <li>{p.id === post.id ? <strong aria-current="page">{entryLabel(p)}</strong> : <a href={`/blog/${p.id}/`}>{entryLabel(p)}</a>}</li>
          ))}
        </ol>
        {adjacent.series.project && <p><a href={`/projects/#${adjacent.series.project.id}`}>프로젝트 글 모아 보기</a></p>}
      </details>
    )}
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      {(adjacent.prev || adjacent.next) && (
        <nav class="post-nav" aria-label="이전 글과 다음 글">
          {adjacent.series && <p class="series">연재 {adjacent.series.index}/{adjacent.series.total}편</p>}
          <div class="pair">
            {adjacent.prev && (
              <a class="prev" href={`/blog/${adjacent.prev.id}/`} rel="prev"><span>이전 글</span><strong>{adjacent.prev.data.title}</strong>{navDescription(adjacent.prev) && <em>{navDescription(adjacent.prev)}</em>}</a>
            )}
            {adjacent.next && (
              <a class="next" href={`/blog/${adjacent.next.id}/`} rel="next"><span>다음 글</span><strong>{adjacent.next.data.title}</strong>{navDescription(adjacent.next) && <em>{navDescription(adjacent.next)}</em>}</a>
            )}
          </div>
        </nav>
      )}
      <p><a href="/">다른 글 보기</a></p>
    </footer>
  </article>
</Base>
