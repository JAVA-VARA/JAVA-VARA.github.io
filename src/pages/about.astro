---
import Base from '../layouts/Base.astro';
import { profile, careerBar, jobs, featured, more, skills, credentials, activities } from '../data/resume';

// 이력서 화면. 내용은 src/data/resume.ts 에서 고친다.

// 경력 막대: 2019-01 부터 올해 12월까지 중 어디를 차지하는지(%)
const SPAN_START = 2019;
const spanEnd = new Date().getFullYear();
const spanMonths = (spanEnd - SPAN_START + 1) * 12;
const months = (ym: string) => {
  const [y, m] = ym === '현재' ? [new Date().getFullYear(), new Date().getMonth() + 1] : ym.split('.').map(Number);
  return (y - SPAN_START) * 12 + (m - 1);
};
const career = careerBar.map((c) => ({
  ...c, now: c.to === '현재',
  from: months(c.from) / spanMonths * 100,
  to: (months(c.to) + 1) / spanMonths * 100,
}));
const years = Array.from({ length: spanEnd - SPAN_START + 1 }, (_, i) => SPAN_START + i);
const external = (href: string) => ({ target: '_blank', rel: 'noopener', href });
---
<Base title="이력서" description={`${profile.name}의 이력서. ${profile.role}.`}>
  <article class="resume">
    <header class="resume-head">
      <img class="photo" src="/images/profile.png" alt={`${profile.name} 사진`} width="150" height="149" />
      <div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="pitch">{profile.pitch}</p>
        <p class="contact"><a href={`mailto:${profile.email}`}>{profile.email}</a> <a {...external(profile.github)}>{profile.github.replace('https://', '')}</a></p>
      </div>
    </header>

    <section class="cv path" aria-label="경력 흐름">
      <ol class="track">
        {career.map((c) => (
          <li class:list={{ now: c.now }} style={`--from:${c.from}%;--to:${c.to}%`}>
            <strong>{c.name}</strong><span>{c.role}</span>
          </li>
        ))}
      </ol>
      <div class="ticks" aria-hidden="true" style={`grid-template-columns:repeat(${years.length},1fr)`}>{years.map((y) => <span>{y}</span>)}</div>
    </section>

    <section class="cv">
      <h2>경력</h2>
      {jobs.map((j) => (
        <div class="entry">
          <div class="entry-head">
            <h3>{j.company}</h3>
            <span class="period">{j.period}</span>
          </div>
          <p class="kind">{j.title}</p>
          <ul>{j.duties.map((d) => <li>{d}</li>)}</ul>
        </div>
      ))}
    </section>

    <section class="cv">
      <h2>대표 프로젝트</h2>
      {featured.map((p) => (
        <div class="entry">
          <div class="entry-head">
            <h3>{p.name}</h3>
            <span class="period">{p.period}</span>
          </div>
          <p class="kind">{p.kind}</p>
          <p>{p.summary}</p>
          <dl class="points">
            {p.points.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          </dl>
          {p.links.length > 0 && (
            <p class="links">{p.links.map(([label, href]) => <a {...external(href)}>{label}</a>)}</p>
          )}
        </div>
      ))}
    </section>

    <section class="cv">
      <h2>그 밖의 프로젝트</h2>
      <ul class="more">
        {more.map((p) => (
          <li>
            <div class="entry-head"><h3>{p.name}</h3><span class="period">{p.period}</span></div>
            <p>{p.line}</p>
            {p.links.length > 0 && <p class="links">{p.links.map(([label, href]) => <a {...external(href)}>{label}</a>)}</p>}
          </li>
        ))}
      </ul>
    </section>

    <section class="cv">
      <h2>기술</h2>
      {skills.map((s) => (
        <div class="skill-row">
          <h3>{s.group}</h3>
          <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </section>

    <section class="cv">
      <h2>자격증·교육</h2>
      <dl class="points">{credentials.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
    </section>

    <section class="cv">
      <details class="extra">
        <summary><h2>대외활동</h2></summary>
        <dl class="points">{activities.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
      </details>
    </section>
  </article>
</Base>
